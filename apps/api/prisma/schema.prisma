// SICFI — Sistema de Control Financiero Individual
//
// Discriminante de tenant: householdId (D2). TODA tabla de datos lo lleva y
// TODO índice empieza por él.
// Dinero: Decimal(14,2). Nunca Float. Nunca number en la aplicación.
// Fechas de negocio: @db.Date (sin hora ni zona). Solo auditoría lleva zona.
//
// Referencia: PLAN_IMPLEMENTACION.md §6 · reglas RN-01..RN-45 en §2

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── ENUMS ─────────────────────────────

/// D3: el ahorro es traslado a fondo, no gasto. RETIRO_AHORRO lo devuelve a caja.
enum MovementType {
  FIJO
  VARIABLE
  AHORRO
  RETIRO_AHORRO
  INGRESO_EXTRA
}

enum Frequency {
  QUINCENAL
  MENSUAL
  BIMESTRAL
  SEMESTRAL
  ANUAL
}

enum PeriodHalf {
  Q1
  Q2
}

/// DERIVADO (RN-18) — el cliente nunca lo envía.
enum AppliesTo {
  Q1
  Q2
  AMBAS
}

enum TxStatus {
  PAGADO
  PENDIENTE
  PROGRAMADO
}

enum CategoryKind {
  FIJO
  VARIABLE
  AHORRO
}

/// RN-43. Jerarquía: OWNER > ADMIN > MEMBER > VIEWER
enum HouseholdRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ExchangeRateSource {
  MANUAL
  BCN
  API
}

// ───────────────────────────── IAM ─────────────────────────────

/// Espejo local de auth.users de Supabase. El id ES el sub del JWT.
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile      Profile?
  memberships  HouseholdMember[]
  transactions Transaction[]     @relation("TxCreatedBy")

  @@map("users")
}

model Profile {
  id          String @id @default(cuid())
  userId      String @unique @map("user_id") @db.Uuid
  displayName String @map("display_name")
  locale      String @default("es-NI")
  timezone    String @default("America/Managua")

  /// Household que el usuario está viendo ahora (RN-42)
  activeHouseholdId String? @map("active_household_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeHousehold Household? @relation(fields: [activeHouseholdId], references: [id], onDelete: SetNull)

  @@index([activeHouseholdId])
  @@map("profiles")
}

// ───────────── HOUSEHOLD — DISCRIMINANTE DE TENANT (D2, RN-42) ─────────────

model Household {
  id   String @id @default(cuid())
  name String

  /// Moneda de consolidación. TODOS los reportes se expresan aquí (RN-36)
  baseCurrency String @default("NIO") @map("base_currency") @db.Char(3)
  timezone     String @default("America/Managua")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members           HouseholdMember[]
  invites           HouseholdInvite[]
  settings          BudgetSettings[]
  categories        Category[]
  paymentMethods    PaymentMethod[]
  savingsFunds      SavingsFund[]
  periods           Period[]
  recurringExpenses RecurringExpense[]
  transactions      Transaction[]
  exchangeRates     ExchangeRate[]
  auditLogs         AuditLog[]
  activeForProfiles Profile[]

  @@map("households")
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String        @map("household_id")
  userId      String        @map("user_id") @db.Uuid
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @map("joined_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  /// Se consulta en CADA request para resolver a qué households pertenece el JWT.
  @@index([userId])
  @@map("household_members")
}

/// Invitación por email; el invitado se une al aceptarla.
model HouseholdInvite {
  id          String        @id @default(cuid())
  householdId String        @map("household_id")
  email       String
  role        HouseholdRole @default(MEMBER)
  token       String        @unique
  expiresAt   DateTime      @map("expires_at")
  acceptedAt  DateTime?     @map("accepted_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, email])
  @@index([householdId])
  @@map("household_invites")
}

// ───────────────────────── CONFIG (hoja Config) ─────────────────────────

model BudgetSettings {
  id          String @id @default(cuid())
  householdId String @map("household_id")
  year        Int
  name        String @default("Mi presupuesto")

  /// null = quincena activa automática por fecha; 1..24 = override manual (Config!C8)
  activePeriodOverride Int? @map("active_period_override")

  /// Config!C12 — no se evalúan alertas de fechas anteriores a esta (RN-35).
  /// Sin esto, un usuario nuevo recibe decenas de falsos "olvidaste pagar".
  controlStartDate DateTime @map("control_start_date") @db.Date

  spendThreshold      Decimal @default(0.80) @map("spend_threshold") @db.Decimal(4, 3) // Umbral_Gasto
  dueSoonDays         Int     @default(3) @map("due_soon_days") // Dias_Aviso
  inactivityDays      Int     @default(5) @map("inactivity_days") // Dias_Sin_Registro
  savingGoalPerPeriod Decimal @default(0) @map("saving_goal_per_period") @db.Decimal(14, 2) // Meta_Ahorro
  paidToleranceAmount Decimal @default(1) @map("paid_tolerance_amount") @db.Decimal(14, 2) // RN-23

  /// Reglas de alerta desactivadas: ["A07","A10"]
  disabledAlerts String[] @default([]) @map("disabled_alerts")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, year])
  @@map("budget_settings")
}

// ───────────────────────── CATÁLOGOS (hoja Listas) ─────────────────────────

model Category {
  id          String       @id @default(cuid())
  householdId String       @map("household_id")
  name        String
  kind        CategoryKind @default(VARIABLE) // "tipo sugerido"
  color       String? // #RRGGBB para gráficas
  icon        String?
  isSystem    Boolean      @default(false) @map("is_system") // vino del seed
  isActive    Boolean      @default(true) @map("is_active")
  sortOrder   Int          @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recurringExpenses RecurringExpense[]
  transactions      Transaction[]
  household         Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, name])
  @@index([householdId, isActive])
  @@map("categories")
}

model PaymentMethod {
  id          String  @id @default(cuid())
  householdId String  @map("household_id")
  name        String
  isSystem    Boolean @default(false) @map("is_system")
  isActive    Boolean @default(true) @map("is_active")
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recurringExpenses RecurringExpense[]
  transactions      Transaction[]
  household         Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, name])
  @@index([householdId, isActive])
  @@map("payment_methods")
}

// ───────────── FONDOS DE AHORRO (D3, RN-39..RN-41) ─────────────

/// saldoFondo = Σ aportes (AHORRO) − Σ retiros (RETIRO_AHORRO), en la moneda del fondo.
model SavingsFund {
  id           String    @id @default(cuid())
  householdId  String    @map("household_id")
  name         String
  currency     String    @default("NIO") @db.Char(3)
  targetAmount Decimal?  @map("target_amount") @db.Decimal(14, 2)
  targetDate   DateTime? @map("target_date") @db.Date
  isDefault    Boolean   @default(false) @map("is_default")
  isActive     Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions Transaction[]
  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, name])
  @@index([householdId, isActive])
  @@map("savings_funds")
}

// ───────────── TIPOS DE CAMBIO (D4, RN-37, RN-38) ─────────────

/// Histórico e INMUTABLE. Se resuelve a la fecha del movimiento; si no hay tasa
/// exacta se usa la más reciente anterior. Primero la del household, luego la global.
model ExchangeRate {
  id String @id @default(cuid())

  /// null = tasa global compartida (p. ej. BCN); con valor = tasa manual del household
  householdId String? @map("household_id")

  baseCurrency  String             @map("base_currency") @db.Char(3) // a la que se convierte
  quoteCurrency String             @map("quote_currency") @db.Char(3) // desde la que se convierte
  date          DateTime           @db.Date
  rate          Decimal            @db.Decimal(18, 8) // 1 quote = rate × base
  source        ExchangeRateSource @default(MANUAL)

  createdAt DateTime @default(now()) @map("created_at")

  household Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, baseCurrency, quoteCurrency, date])
  @@index([baseCurrency, quoteCurrency, date(sort: Desc)])
  @@index([householdId, baseCurrency, quoteCurrency, date(sort: Desc)])
  @@map("exchange_rates")
}

// ───────────────────────── QUINCENAS (hoja Quincenas) ─────────────────────────

/// Q1 = días 1–15. Q2 = día 16 al fin de mes. 24 por año (RN-01, RN-02).
model Period {
  id          String     @id @default(cuid())
  householdId String     @map("household_id")
  year        Int
  number      Int // 1..24
  month       Int // 1..12
  half        PeriodHalf
  startDate   DateTime   @map("start_date") @db.Date
  endDate     DateTime   @map("end_date") @db.Date

  /// Quincenas!G — ÚNICO input de esa hoja. null = aún no planificado (dispara A01)
  plannedIncome         Decimal? @map("planned_income") @db.Decimal(14, 2)
  plannedIncomeCurrency String   @default("NIO") @map("planned_income_currency") @db.Char(3)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions Transaction[]
  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, year, number])
  /// Resolución de periodId a partir de una fecha (RN-03, RN-29)
  @@index([householdId, startDate, endDate])
  @@map("periods")
}

// ───────────────────────── FIJOS (hoja Fijos) ─────────────────────────

model RecurringExpense {
  id          String    @id @default(cuid())
  householdId String    @map("household_id")
  code        String // F01, F02… estable
  categoryId  String    @map("category_id")
  concept     String
  amount      Decimal   @db.Decimal(14, 2)
  currency    String    @default("NIO") @db.Char(3)
  dueDay      Int       @map("due_day") // 1..31
  frequency   Frequency @default(QUINCENAL)

  /// DERIVADO (RN-18): QUINCENAL → AMBAS; si no, dueDay <= 15 ? Q1 : Q2.
  /// Se persiste para poder agregar en SQL (RN-07). Nunca lo escribe el cliente.
  appliesTo AppliesTo @map("applies_to")

  paymentMethodId String?   @map("payment_method_id")
  /// Baja lógica (RN-20). Un fijo inactivo tiene costoMensual = 0 (RN-19).
  isActive        Boolean   @default(true) @map("is_active")
  notes           String?
  startDate       DateTime? @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  transactions  Transaction[]
  household     Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, code])
  @@unique([householdId, concept])
  @@index([householdId, isActive, appliesTo])
  @@index([householdId, categoryId])
  @@index([householdId, paymentMethodId])
  @@map("recurring_expenses")
}

// ───────────────────────── MOVIMIENTOS (hoja Registro) ─────────────────────────

model Transaction {
  id          String       @id @default(cuid())
  householdId String       @map("household_id")
  date        DateTime     @db.Date
  /// DERIVADO de date (RN-03, RN-29). Persistido para evitar un rango de fechas
  /// en cada agregación. Se recalcula si cambia la fecha.
  periodId    String       @map("period_id")
  type        MovementType
  categoryId  String       @map("category_id")
  concept     String

  /// FK en vez de coincidencia por texto. Obligatorio si type = FIJO (RN-26)
  recurringExpenseId String? @map("recurring_expense_id")

  /// Obligatorio si type ∈ {AHORRO, RETIRO_AHORRO} (RN-39)
  savingsFundId String? @map("savings_fund_id")

  // ── Dinero multimoneda (D4, RN-36..RN-38) ──
  amount       Decimal @db.Decimal(14, 2) // en la moneda original, como lo capturó el usuario
  currency     String  @default("NIO") @db.Char(3)
  exchangeRate Decimal @default(1) @map("exchange_rate") @db.Decimal(18, 8)

  /// amount × exchangeRate. TODA agregación de reportes usa ESTE campo (RN-36).
  /// Un SUM(amount) en analytics es un bug.
  baseAmount Decimal @map("base_amount") @db.Decimal(14, 2)

  paymentMethodId String?  @map("payment_method_id")
  status          TxStatus @default(PAGADO)
  notes           String?

  /// Atribución dentro de un household compartido. Inmutable (RN-45)
  createdByUserId String @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  paymentMethod    PaymentMethod?    @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  period           Period            @relation(fields: [periodId], references: [id], onDelete: Restrict)
  recurringExpense RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  savingsFund      SavingsFund?      @relation(fields: [savingsFundId], references: [id], onDelete: Restrict)
  createdBy        User              @relation("TxCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  household        Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, date(sort: Desc)])
  @@index([householdId, periodId, type])
  @@index([householdId, categoryId])
  @@index([householdId, recurringExpenseId, periodId])
  @@index([householdId, savingsFundId])
  @@index([householdId, paymentMethodId])
  @@index([createdByUserId])
  @@map("transactions")
}

// ───────────────────────── AUDITORÍA ─────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  householdId String   @map("household_id")
  userId      String   @map("user_id") @db.Uuid
  entity      String
  entityId    String   @map("entity_id")
  action      String // CREATE | UPDATE | DELETE
  changes     Json
  at          DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, at(sort: Desc)])
  @@index([householdId, entity, entityId])
  @@map("audit_logs")
}
