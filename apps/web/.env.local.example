# Configuración pública de Supabase (Fase 6).
#
# Las dos variables llevan el prefijo NEXT_PUBLIC_ porque el navegador las
# necesita: son públicas por diseño. Quien decide qué puede hacer un usuario es
# su JWT, no el secreto de esta clave.
#
# NUNCA pongas aquí la SUPABASE_SECRET_KEY (service_role): salta RLS por
# completo y con el prefijo NEXT_PUBLIC_ acabaría en el bundle del cliente.
# El backend tampoco la necesita — verifica los JWT contra el JWKS público.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# URL de la API de Nest. En local, el puerto 3001.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
