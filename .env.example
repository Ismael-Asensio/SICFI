# ═══════════════════════════════════════════════════════════════════
#  SICFI — plantilla de variables de entorno
#  Copia este archivo a .env (backend) y apps/web/.env.local (frontend).
#  NUNCA commitees el .env real.
# ═══════════════════════════════════════════════════════════════════

# ─────────────────────────── apps/api (NestJS) ───────────────────────────

# Conexión de RUNTIME: pooler de Supabase (Supavisor), modo transaction.
# OBLIGATORIO en serverless: sin pgbouncer=true&connection_limit=1 se agotan
# las conexiones de Postgres al primer pico de tráfico.
# Supabase → Project Settings → Database → Connection string → Transaction pooler
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexión DIRECTA: solo la usa `prisma migrate` / `prisma db push`.
# El pooler en modo transaction no soporta sentencias preparadas de DDL.
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Auth — verificación del JWT en el backend
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_JWKS_URL="https://[PROJECT_REF].supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_JWT_ISSUER="https://[PROJECT_REF].supabase.co/auth/v1"
SUPABASE_JWT_AUDIENCE="authenticated"

# CORS: origen exacto del frontend (sin barra final)
WEB_ORIGIN="http://localhost:3000"

# Servidor
NODE_ENV="development"
PORT="3001"
API_PREFIX="api/v1"

# Rate limiting (@nestjs/throttler)
THROTTLE_TTL_SECONDS="60"
THROTTLE_LIMIT="100"
THROTTLE_AUTH_LIMIT="10"

# Observabilidad (opcional en desarrollo)
SENTRY_DSN=""
LOG_LEVEL="debug"

# Cron: secreto que valida que la petición viene de Vercel Cron
CRON_SECRET="genera-uno-largo-y-aleatorio"


# ─────────────────────────── apps/web (Next.js) ───────────────────────────
# Estas van en apps/web/.env.local
# Las NEXT_PUBLIC_* SÍ llegan al navegador: nunca pongas secretos ahí.

NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"


# ─────────────────────────── NUNCA en el cliente ───────────────────────────
# SUPABASE_SERVICE_ROLE_KEY salta toda la seguridad de fila (RLS).
# Úsala solo en scripts de servidor/seed y jamás con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""
